# Required — Neon pooled connection for app runtime (hostname contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Required — Neon direct connection for drizzle-kit migrations (no -pooler in hostname)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Required — Auth.js session secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Required on Vercel — canonical app URL (no trailing slash), e.g. https://champions.example.com
AUTH_URL=

# Required on Vercel — trust the Host header behind the Vercel proxy (set to true)
AUTH_TRUST_HOST=true

# reCAPTCHA v2 — required in production when RECAPTCHA_SECRET_KEY is set.
# In non-production, verification is bypassed when RECAPTCHA_SECRET_KEY is absent.
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
